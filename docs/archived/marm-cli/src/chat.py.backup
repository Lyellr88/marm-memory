"""Interactive chat loop with MARM tool integration"""
import asyncio
import logging
from typing import List
from pathlib import Path

from prompt_toolkit import Application
from prompt_toolkit.layout import Layout, HSplit, VSplit, Window, FormattedTextControl
from prompt_toolkit.layout.dimension import Dimension as D
from prompt_toolkit.widgets import TextArea, Frame
from prompt_toolkit.key_binding import KeyBindings
from prompt_toolkit.styles import Style
from prompt_toolkit.formatted_text import HTML
from prompt_toolkit.history import FileHistory

from marm import (
    OllamaClient,
    Message,
    ProtocolInjector,
    get_tool_registry,
    get_all_marm_tools,
    MARMDatabase,
    AutomationManager,
)
from config.settings import get_settings
from help_menu import show_help_menu

logger = logging.getLogger(__name__)


class MARMChat:
    """Interactive MARM chat session with tool support and automation"""

    def __init__(self):
        self.settings = get_settings()
        self.protocol = ProtocolInjector()
        self.registry = get_tool_registry()

        # Register all 14 MARM tools
        for tool in get_all_marm_tools():
            self.registry.register(tool)
        logger.info(f"Registered {len(self.registry._tools)} MARM tools")
        self.ollama = OllamaClient(
            base_url=self.settings.ollama.base_url,
            model=self.settings.ollama.model,
            tool_registry=self.registry
        )
        self.db = MARMDatabase(self.settings.marm.database_path)
        self.messages: List[Message] = []
        # Generate valid session ID (replace decimal point with underscore)
        timestamp = str(int(asyncio.get_event_loop().time() * 1000000))
        self.session_id = f"chat-{timestamp}"

        # Build system prompt with MARM protocol
        system_prompt = self.protocol.build_system_prompt()
        self.messages.append(Message(role="system", content=system_prompt))

        # UI state
        self.thinking_mode = None  # None, "think", or "super think"
        self.skip_clear_warning = False  # User chose "d" to disable /clear warning
        self.conversation_history = []  # Store formatted messages for display

        # Create modern chat interface components
        self.output_area = Window(
            content=FormattedTextControl(text=self._get_conversation_text),
            wrap_lines=True,
            always_hide_cursor=True,
        )

        # Input box at bottom (like Claude/ChatGPT)
        self.input_field = TextArea(
            height=D(min=3, max=10),
            prompt='>>> ',
            multiline=True,
            wrap_lines=True,
            scrollbar=True,
            focus_on_click=True,
        )

        # Setup keyboard shortcuts
        kb = self._create_keybindings()

        # Initialize automation manager with same session_id as chat
        self.automation = AutomationManager(session_name=self.session_id)
        logger.info(f"Automation systems initialized for session '{self.session_id}'")

    def _get_conversation_text(self):
        """Format conversation history with styling"""
        result = []
        for msg in self.conversation_history:
            if msg['role'] == 'user':
                # Grey background for user messages with bright white text
                result.append(('class:user-message', f"\n{msg['content']}\n"))
            else:
                # AI messages in normal style
                result.append(('class:ai-message', f"\n{msg['content']}\n"))
        return result

    def _create_keybindings(self) -> KeyBindings:
        """Create custom keyboard shortcuts"""
        kb = KeyBindings()

        # Ctrl+L - Clear screen (instant, no confirmation)
        @kb.add("c-l")
        def clear_screen(event):
            """Clear screen (visual only, context preserved)"""
            import os

            # Use OS-specific clear command
            os.system('cls' if os.name == 'nt' else 'clear')

            # Re-display MARM header
            self._display_header()
            console.print("[dim]✓ Screen cleared (context preserved)[/dim]\n")

        # Ctrl+D - Exit immediately (standard unix behavior)
        @kb.add("c-d")
        def exit_immediately(event):
            """Exit CLI immediately (session auto-saved)"""
            # Use prompt_toolkit's proper exit method
            event.app.exit()

        # Escape (single) - Show hint to press again
        @kb.add("escape")
        def escape_hint(event):
            """Show hint on first Escape press"""
            if not self.escape_pressed_once:
                self.escape_pressed_once = True
                # Print hint with enough spaces to clear any previous content
                console.print("[dim]Press Escape again to clear input[/dim]" + " " * 50, end="\r")
            else:
                # Second press - clear input
                buffer_text = event.current_buffer.text
                if buffer_text.strip():
                    event.current_buffer.reset()
                    # Clear the hint line completely
                    console.print("[yellow]✗ Input cleared[/yellow]" + " " * 50)
                self.escape_pressed_once = False

        # Tab (double-tap) - Turn off thinking mode
        @kb.add("tab")
        def tab_thinking_toggle(event):
            """Double-tap Tab to turn off thinking mode"""
            import time
            current_time = time.time()

            # If this is within 0.5 seconds of last tab press
            if hasattr(self, '_last_tab_time') and (current_time - self._last_tab_time) < 0.5:
                self.tab_press_count += 1
                if self.tab_press_count >= 2:
                    # Double-tap detected - turn off thinking mode
                    if self.thinking_mode:
                        self.thinking_mode = None
                        console.print(f"[dim]💭 Thinking mode disabled[/dim]")
                    self.tab_press_count = 0
            else:
                # First tap or too slow - reset counter and do normal tab behavior
                self.tab_press_count = 1
                event.current_buffer.insert_text("    ")  # Insert 4 spaces

            self._last_tab_time = current_time

        return kb

    def _display_header(self):
        """Display MARM CLI header"""
        console.print(Panel.fit(
            "[bold cyan]MARM CLI v1.0.0[/bold cyan]\n"
            "Memory Accurate Response Mode\n\n"
            "Type [bold]exit[/bold] or [bold]quit[/bold] to end session\n"
            "Type [bold]/help[/bold] for commands",
            border_style="cyan"
        ))

    async def run(self):
        """Run interactive chat loop"""
        self._display_header()

        # Test Ollama connectivity on startup
        try:
            import httpx
            async with httpx.AsyncClient(timeout=5.0) as client:
                response = await client.get(f"{self.settings.ollama.base_url}/api/tags")
                response.raise_for_status()
                console.print(f"[dim green]✓ Connected to Ollama ({self.settings.ollama.model})[/dim green]")
                console.print(f"[dim green]✓ {len(self.registry._tools)} MARM tools available[/dim green]\n")
        except Exception as e:
            console.print(f"[yellow]⚠️  Warning: Cannot connect to Ollama at {self.settings.ollama.base_url}[/yellow]")
            console.print(f"[dim]Error: {e}[/dim]\n")

        while True:
            try:
                # Get user input using prompt_toolkit's async method
                user_input = await self.prompt_session.prompt_async()

                # Handle Ctrl+D exit (prompt returns None when event.app.exit() is called)
                if user_input is None:
                    console.print("\n[yellow]Ending session...[/yellow]")
                    break

                if not user_input.strip():
                    continue

                # Check for exit commands
                if user_input.lower() in ["exit", "quit", "/exit", "/quit"]:
                    console.print("\n[yellow]Ending session...[/yellow]")
                    break

                # Check for help command
                if user_input.lower() in ["/help", "help"]:
                    await show_help_menu()
                    # Force screen refresh after help menu
                    import os
                    import time
                    time.sleep(0.1)  # Brief pause to let terminal settle
                    # Print newline to trigger prompt redraw
                    console.print()
                    continue

                # Check for clear command - HARD RESET (wipes conversation)
                if user_input.lower() in ["/clear", "clear"]:
                    # Show confirmation unless user disabled it
                    if not self.skip_clear_warning:
                        console.print("\n[yellow bold]⚠️  Warning: This will reset your entire conversation![/yellow bold]")
                        console.print("[yellow]All messages and context will be lost.[/yellow]")
                        console.print("\n[cyan]Options:[/cyan]")
                        console.print("  [bold]y[/bold] = Yes, reset conversation")
                        console.print("  [bold]n[/bold] = No, cancel")
                        console.print("  [bold]d[/bold] = Yes, and don't show this warning again\n")

                        # Get user confirmation
                        while True:
                            try:
                                confirm = await asyncio.to_thread(
                                    input,
                                    "Your choice [y/n/d]: "
                                )
                                confirm = confirm.lower().strip()

                                if confirm == 'n':
                                    console.print("[dim]✓ Clear cancelled[/dim]\n")
                                    break
                                elif confirm == 'y':
                                    # Hard reset - clear conversation history
                                    self.messages.clear()
                                    system_prompt = self.protocol.build_system_prompt()
                                    self.messages.append(Message(role="system", content=system_prompt))

                                    import os
                                    os.system('cls' if os.name == 'nt' else 'clear')
                                    self._display_header()
                                    console.print("[dim green]✓ Conversation reset - starting fresh![/dim green]\n")
                                    break
                                elif confirm == 'd':
                                    # Disable warning and reset
                                    self.skip_clear_warning = True
                                    self.messages.clear()
                                    system_prompt = self.protocol.build_system_prompt()
                                    self.messages.append(Message(role="system", content=system_prompt))

                                    import os
                                    os.system('cls' if os.name == 'nt' else 'clear')
                                    self._display_header()
                                    console.print("[dim green]✓ Conversation reset - warning disabled for this session[/dim green]\n")
                                    break
                                else:
                                    console.print("[red]Invalid choice. Please enter y, n, or d[/red]")
                            except (EOFError, KeyboardInterrupt):
                                console.print("\n[dim]✓ Clear cancelled[/dim]\n")
                                break
                    else:
                        # Warning disabled - reset immediately
                        self.messages.clear()
                        system_prompt = self.protocol.build_system_prompt()
                        self.messages.append(Message(role="system", content=system_prompt))

                        import os
                        os.system('cls' if os.name == 'nt' else 'clear')
                        self._display_header()
                        console.print("[dim green]✓ Conversation reset - starting fresh![/dim green]\n")

                    continue

                # Check for thinking mode activation
                if user_input.lower().strip() == "super think":
                    self.thinking_mode = "super"
                    console.print("[cyan]💭 Super thinking mode enabled - all responses will show maximum reasoning depth[/cyan]")
                    console.print("[dim]Tip: Double-tap Tab to disable[/dim]\n")
                    continue

                if user_input.lower().strip() == "think":
                    self.thinking_mode = "normal"
                    console.print("[cyan]💭 Thinking mode enabled - all responses will show reasoning process[/cyan]")
                    console.print("[dim]Tip: Double-tap Tab to disable[/dim]\n")
                    continue

                # Reset Ctrl+C state when starting new message
                self.ctrl_c_pressed_once = False

                # Add user message to history (clean, unmodified)
                self.messages.append(Message(role="user", content=user_input))

                # Save to database
                self.db.add_conversation(
                    session_id=self.session_id,
                    user_message=user_input,
                    ai_response="",  # Will update after response
                )

                # Get response from LLM with tool support
                console.print()
                try:
                    with console.status("[cyan]Thinking... (Press Ctrl+C to cancel)[/cyan]", spinner="dots"):
                        response = await asyncio.wait_for(
                            self._get_response_with_tools(user_input),
                            timeout=300.0  # 5 minute timeout
                        )
                except KeyboardInterrupt:
                    # User pressed Ctrl+C to cancel - check if double-press for exit
                    import time
                    current_time = time.time()

                    if self.ctrl_c_pressed_once and (current_time - self.last_ctrl_c_time) < 2.0:
                        # Double press within 2 seconds - exit
                        console.print(f"\n[yellow]Exiting MARM CLI...[/yellow]")
                        break
                    else:
                        # First press - cancel operation
                        self.ctrl_c_pressed_once = True
                        self.last_ctrl_c_time = current_time
                        console.print(f"\n[yellow]⚠️  Response cancelled. Press Ctrl+C again to exit.[/yellow]\n")
                        logger.info("User cancelled response with Ctrl+C")
                        # Remove the user message from history since we didn't get a response
                        if self.messages and self.messages[-1].role == "user":
                            self.messages.pop()
                        continue
                except asyncio.CancelledError:
                    # Task was cancelled (from Ctrl+C or other interruption)
                    console.print(f"\n[yellow]⚠️  Response cancelled[/yellow]\n")
                    logger.info("Response task was cancelled")
                    # Remove the user message from history
                    if self.messages and self.messages[-1].role == "user":
                        self.messages.pop()
                    continue
                except asyncio.TimeoutError:
                    console.print(f"[red]⏱️  Request timed out after 5 minutes[/red]")
                    console.print(f"[yellow]Check if Ollama is running: curl http://localhost:11434/api/tags[/yellow]")
                    logger.error("Request timed out waiting for Ollama response")
                    continue
                except ConnectionError as e:
                    console.print(f"[red]🔌 Connection error: Cannot reach Ollama at {self.settings.ollama.base_url}[/red]")
                    console.print(f"[yellow]Tip: Start Ollama with 'docker-compose up -d'[/yellow]")
                    logger.error(f"Connection error: {e}")
                    continue
                except Exception as e:
                    console.print(f"[red]❌ Error getting response: {e}[/red]")
                    logger.exception("Error during LLM response")
                    continue

                # Add assistant response to history
                self.messages.append(response)

                # Run automation (silent background processing)
                automation_results = self.automation.process_conversation(
                    user_message=user_input,
                    ai_response=response.content
                )

                # Log automation activity (debug level)
                if automation_results["auto_logged"]:
                    logger.debug("Auto-logged conversation")
                if automation_results["context_shifted"]:
                    logger.debug("Context shift detected and bridged")
                if automation_results["refreshed"]:
                    logger.info("Protocol auto-refreshed")
                    # Update system prompt in messages
                    new_prompt = self.protocol.build_system_prompt()
                    self.messages[0] = Message(role="system", content=new_prompt)

                # Force terminal refresh to ensure prompt reappears immediately
                import sys
                sys.stdout.flush()
                sys.stderr.flush()

            except asyncio.CancelledError:
                # asyncio.to_thread was cancelled (Ctrl+C during input prompt)
                console.print("\n\n[yellow]Exiting MARM CLI...[/yellow]")
                break
            except KeyboardInterrupt:
                # Ctrl+C pressed outside of AI response - check for double-press
                import time
                current_time = time.time()

                if self.ctrl_c_pressed_once and (current_time - self.last_ctrl_c_time) < 2.0:
                    # Double press within 2 seconds - exit
                    console.print("\n\n[yellow]Exiting MARM CLI...[/yellow]")
                    break
                else:
                    # First press - show warning and continue
                    self.ctrl_c_pressed_once = True
                    self.last_ctrl_c_time = current_time
                    console.print("\n[yellow]Press Ctrl+C again within 2 seconds to exit[/yellow]")
                    continue
            except EOFError:
                console.print("\n\n[yellow]Ending session...[/yellow]")
                break
            except Exception as e:
                # Show error in Rich Panel
                error_panel = Panel(
                    f"[red bold]Error:[/red bold] {str(e)}\n\n"
                    f"[dim]Check logs for details[/dim]",
                    title="❌ Runtime Error",
                    border_style="red"
                )
                console.print(error_panel)
                logger.exception("Chat error")
                continue

        # Clean up after loop ends
        await self.ollama.close()
        self.db.close()

    async def _get_response_with_tools(self, user_input: str) -> Message:
        """
        Get response from LLM with automatic tool calling

        Args:
            user_input: User's message

        Returns:
            Assistant's response message
        """
        # Track tool calls for display
        tool_calls_made = []
        tool_errors = []

        def on_tool_call(tool_name: str, tool_args: dict):
            """Callback when tool is called"""
            tool_calls_made.append((tool_name, tool_args))
            console.print(f"[dim]🔧 Calling tool: {tool_name}[/dim]")

        try:
            # Prepare messages for LLM (may include temporary thinking mode instruction)
            messages_to_send = self.messages.copy()

            # If thinking mode is enabled, inject temporary system message
            if self.thinking_mode:
                thinking_instruction = None

                if self.thinking_mode == "super":
                    thinking_instruction = "Extended thinking mode: Use maximum reasoning depth and show all intermediate steps. Break down your reasoning into clear, logical steps."
                elif self.thinking_mode == "normal":
                    thinking_instruction = "Thinking mode: Show your reasoning process step-by-step before providing your answer."

                # Inject as a temporary system message right before the last user message
                if thinking_instruction:
                    messages_to_send.insert(-1, Message(role="system", content=thinking_instruction))

            # Get completion with automatic tool execution
            response = await self.ollama.chat_completion(
                messages=messages_to_send,
                on_tool_call=on_tool_call
            )

            # Display tool calls summary if any were made
            if tool_calls_made:
                console.print(f"\n[dim]✓ Executed {len(tool_calls_made)} tool(s)[/dim]\n")

            # Display response
            if response.content:
                md = Markdown(response.content)
                console.print(md)
            else:
                # Debug: Show if response is empty
                console.print("[yellow]⚠️  Received empty response from AI[/yellow]")
                logger.warning(f"Empty response received. Response object: {response}")

            return response

        except Exception as e:
            # Show unexpected error
            error_panel = Panel(
                f"[red bold]Unexpected Error:[/red bold]\n\n{str(e)}",
                title="❌ Error",
                border_style="red"
            )
            console.print(error_panel)
            logger.exception("Unexpected error during tool execution")
            return Message(role="assistant", content=f"Error: {str(e)}")


async def start_chat():
    """Start interactive chat session"""
    chat = MARMChat()
    await chat.run()


if __name__ == "__main__":
    asyncio.run(start_chat())

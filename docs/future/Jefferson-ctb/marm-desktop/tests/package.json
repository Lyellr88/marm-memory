{
  "name": "marm-desktop-tests",
  "version": "1.0.0",
  "description": "Unit tests for MARM Desktop security and build validation",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:security": "jest --testPathPattern=security",
    "test:build": "jest --testPathPattern=build",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.8",
    "babel-jest": "^30.1.2",
    "jest": "^30.1.2",
    "jest-environment-jsdom": "^30.1.2",
    "yaml": "^2.8.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "globals": {
      "__filename": true,
      "__dirname": true
    },
    "transform": {
      "^.+\\.(js|jsx)$": [
        "babel-jest",
        {
          "useESM": true
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.(js|jsx)",
      "**/?(*.)(test|spec).(js|jsx)"
    ],
    "collectCoverageFrom": [
      "../src/**/*.js",
      "!../src/main.js",
      "!../node_modules/**"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}

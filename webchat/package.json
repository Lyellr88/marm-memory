{
  "name": "marm-v2",
  "version": "2.0.0",
  "main": "index.js",
  "type": "module",
  "description": "MARM v2.0 - Memory Accurate Response Mode. AI chatbot with enhanced memory, modern glassmorphism UI, and professional testing infrastructure.",
  "keywords": ["ai", "chatbot", "memory", "conversation", "marm", "llama", "glassmorphism", "testing", "llama4", "javascript", "ai-assistant"],
  "author": "Lyell",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "start": "node src/chatbot/server.js",
    "dev": "nodemon src/chatbot/server.js"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.0.5",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "setupFiles": ["<rootDir>/jest.setup.js"]
  }
}

{
  "manifest_version": "0.4",
  "name": "marm-memory",
  "display_name": "MARM Memory",
  "version": "__MARM_VERSION__",
  "description": "Local-first MCP memory, code graph, and concept graph server.",
  "long_description": "MARM stores memories, code indexes, and concept graphs on the local machine. This bundle launches the existing MARM stdio transport without a hosted endpoint or OAuth.",
  "author": {
    "name": "Ryan Lyell",
    "email": "support@marmemory.com",
    "url": "https://marmsystems.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lyellr88/marm-memory.git"
  },
  "homepage": "https://marmsystems.com",
  "documentation": "https://github.com/Lyellr88/marm-memory#readme",
  "support": "https://github.com/Lyellr88/marm-memory/issues",
  "icon": "icon.png",
  "server": {
    "type": "uv",
    "entry_point": "marm_mcpb_entry.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--project",
        "${__dirname}",
        "${__dirname}/marm_mcpb_entry.py"
      ]
    }
  },
  "keywords": ["memory", "codebase", "knowledge-graph", "local-first", "privacy", "mcp"],
  "license": "Apache-2.0",
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "python": ">=3.10,<4"
    }
  }
}
